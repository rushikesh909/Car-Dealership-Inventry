# Application Ports
PORT=3000
VITE_API_URL=http://localhost:3000/api

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/cardealership?replicaSet=rs0&directConnection=true
TEST_DATABASE_URL=mongodb://127.0.0.1:27017/cardealership_test?replicaSet=rs0&directConnection=true

# JWT Authentication
JWT_SECRET=super-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=1d

# Security & CORS
CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5

# Seed Admin User
ADMIN_EMAIL=admin@cardealership.com
ADMIN_PASSWORD=AdminSecurePassword123!
