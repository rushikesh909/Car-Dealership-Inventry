# Application Port
PORT=3000
NODE_ENV=development

# Database Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cardealership?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cardealership_test?schema=public

# Authentication & Security
JWT_SECRET=super-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (nestjs/throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5

# Admin Seed Credentials
ADMIN_EMAIL=admin@cardealership.com
ADMIN_PASSWORD=AdminSecurePassword123!
